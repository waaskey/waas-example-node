# Publishable API key from the Waaskey dashboard
WAASKEY_API_KEY=
# Secret sealing the device share at rest (>= 16 chars, high entropy)
SHARE_SECRET=
# REQUIRED: the API origin of your WAASKey deployment, including the /api prefix.
# There is no public sandbox and the SDK's built-in default does not resolve.
WAASKEY_BASE_URL=
# Optional: email enrolled as a recovery factor
#RECOVERY_EMAIL=
