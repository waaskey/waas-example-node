{
  "name": "waas-example-node",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Waaskey Node.js quickstart — non-custodial MPC wallet create + sign, no browser",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "start": "node index.mjs",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "types": "node --check index.mjs",
    "build": "node --check index.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@waaskey/client-wasm": "0.2.1",
    "@waaskey/sdk": "0.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.0"
  }
}
